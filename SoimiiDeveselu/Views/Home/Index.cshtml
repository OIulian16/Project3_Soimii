@model SoimiiDeveselu.Models.ClubInfo

@{
    ViewData["Title"] = "Acasă";
}

<div class="container mt-5 content">
    <div class="text-center mb-5">
        <h2 class="titlu-principal">Bine ați venit pe site-ul oficial!</h2>
        <div class="underline-titlu"></div>
        
      
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <img id="img-stadion" src="~/Poze/stadion.jpg" alt="Teren Șoimii" class="img-fluid rounded shadow-sm mb-4">
    
            <h4 class="custom-section-header"><i class="fas fa-landmark"></i> Informații Stadion</h4>
            <ul id="lista-info" class="mt-3 custom-list">
                <li><i class="fas fa-map-marker-alt"></i> <strong>Nume:</strong> @(Model?.StadiumName ?? "Nespecificat")</li>
                <li><i class="fas fa-city"></i> <strong>Localitate:</strong> @(Model?.Location ?? "Nespecificat")</li>
                <li><i class="fas fa-users"></i> <strong>Capacitate:</strong> @(Model?.Capacity ?? 0) locuri</li>
                <li><i class="fas fa-seedling"></i> <strong>Suprafață:</strong> @(Model?.Surface ?? "Nespecificat")</li>
                <li><i class="fas fa-ruler-combined"></i> <strong>Dimensiuni:</strong> @(Model?.Dimensions ?? "Nespecificat")</li>
            </ul>
        </div>

        <div class="col-md-6 mb-4" style="padding-left: 30px;">
            <h4 class="custom-section-header"><i class="fas fa-info-circle"></i> Despre Noi</h4>
            <p class="mt-3 description-text">
                @Model?.Description
            </p>

            <div class="mt-4">
                @if (!string.IsNullOrEmpty(Model?.Goals))
                {
                    var lines = Model.Goals.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
                    bool insideList = false;

                    foreach (var line in lines)
                    {
                        bool isTitle = line.Equals(line.ToUpper()) && line.Any(char.IsLetter);

                        if (isTitle)
                        {
                            if (insideList)
                            {
                                @:</ul>
                                insideList = false;
                            }
                            <h5 class="custom-section-header mt-4" style="font-size: 1.1rem;">
                                @if (line.Contains("PALMARES"))
                                {
                                    <i class="fas fa-trophy"></i>
                                }
                                else
                                {
                                    <i class="fas fa-bullseye"></i>
                                }
                                @line
                            </h5>
                        }
                        else
                        {
                            if (!insideList) 
                            { 
                                @:<ul class="custom-check-list">
                                insideList = true; 
                            }
                            <li>@line.TrimStart('-', '*', ' ')</li>
                        }
                    }
                    if (insideList) 
                    { 
                        @:</ul> 
                    }
                }
            </div>

            <div class="mt-5 text-center">
                <a asp-controller="Matches" asp-action="Index" class="btn btn-primary btn-match-custom shadow-sm">
                    <i class="fas fa-calendar-alt"></i> Vezi Meciuri & Rezultate
                </a>
            </div>
        </div>
    </div>
</div>