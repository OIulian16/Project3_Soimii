<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AS Șoimii Deveselu</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
    <link rel="icon" href="~/Poze/soimii.png" type="image/png">
</head>
<body>
    <div class="header container-fluid">
        <div class="row">
            <div class="col-sm-8">
                <img id="img-logo" src="~/Poze/soimii.png" alt="Logo Soimii">
                <h1>AS Șoimii Deveselu</h1>
            </div>
            <div class="col-sm-4" style="text-align: right; margin-top: 15px;">
                @using Microsoft.AspNetCore.Identity
            @inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
                {
                    <span class="text-white me-3">Salut, @User.Identity.Name!</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-outline-light" style="font-weight: bold;">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light" style="color: #003366; font-weight: bold;">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light">Register</a>
                }
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-sm navbar-dark topnav-custom">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Acasă</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Players" asp-action="Index">Lot Jucători</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Matches" asp-action="Index">Rezultate & Meciuri</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Standings" asp-action="Index">Clasament</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Transfers" asp-action="Index">Transferuri</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Records" asp-action="Index">Statistici</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="History" asp-action="Index">Istorie</a></li>
            </ul>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <footer class="footer">
        <div class="container">
            <p>&copy; @DateTime.Now.Year - AS Șoimii Deveselu - Proiect</p>
        </div>
    </footer>
</body>
</html>