@model IEnumerable<SoimiiDeveselu.Models.Standing>

@{
    ViewData["Title"] = "Clasament";
    int totalEchipe = Model.Count();
}

<div class="container mt-5 content">
    <div class="text-center mb-4">
        <h2 class="titlu-principal">Clasament - Liga a 5-a (Seria 3) - 2026/2027</h2>
        <div class="underline-titlu"></div>
    </div>
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-hover table-clasament mb-0">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="text-align: left; padding-left: 15px;">Echipa</th>
                    <th>M</th>
                    <th>V</th>
                    <th>E</th>
                    <th>I</th>
                    <th>GM</th>
                    <th>GP</th>
                    <th>GJ</th>
                    <th>P</th>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <th>Acțiuni Admin</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    int nr = 1;
                }
                @foreach (var item in Model)
                {

                    bool esteSoimii = item.TeamName.Contains("Soimii") || item.TeamName.Contains("Șoimii");
                    string clasaPozitie = "";
                    if (nr == 1) { clasaPozitie = "linie-campioana"; }
                    else if (nr > totalEchipe - 2 && totalEchipe >= 4) { clasaPozitie = "linie-retrogradare"; }
                    else if (esteSoimii) { clasaPozitie = "linie-soimii"; }

                    <tr class="@clasaPozitie">
                        <td class="font-weight-bold">@(nr++)</td>
                        <td class="nume-echipa">
                            @if (esteSoimii)
                            {
                                <a asp-controller="Home" asp-action="Index" class="echipa-noastra-link">
                                    @item.TeamName
                                </a>
                            }
                            else
                            {
                                <span class="text-dark-bold">@item.TeamName</span>
                            }
                        </td>
                        <td>@item.MatchesPlayed</td>
                        <td>@item.Wins</td>
                        <td>@item.Draws</td>
                        <td>@item.Losses</td>
                        <td>@item.GoalsFor</td>
                        <td>@item.GoalsAgainst</td>
                        <td class="font-italic">
                            @((item.GoalsFor - item.GoalsAgainst) > 0 ? "+" : "")@(item.GoalsFor - item.GoalsAgainst)
                        </td>
                        <td class="punctaj-celula"><strong>@item.Points p</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="p-3 legenda-box shadow-sm rounded bg-light border border-secondary-subtle">
                <h6 class="font-weight-bold text-uppercase small text-muted mb-2"><i class="fas fa-info-circle"></i> Legenda</h6>
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex align-items-center">
                        <span class="legenda-indicator bg-campioana me-2"></span>
                        <span>Locul 1: Promovare directă în Liga a 4-a</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="legenda-indicator bg-retrogradare me-2"></span>
                        <span>Ultimele 2 locuri: Risc de Retrogradare în Liga a 6-a / Baraj</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="legenda-indicator bg-soimii-color me-2"></span>
                        <span>Echipa noastra</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>